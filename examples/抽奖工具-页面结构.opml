<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head><title>抽奖工具 页面结构</title></head>
  <body>
    <outline text="抽奖工具">
      <outline text="3.0 全局组件">
        <outline text="登录注册弹窗（3.0.1）"/>
        <outline text="提示条（3.0.2）"/>
      </outline>
      <outline text="3.1 活动主页">
        <outline text="顶部导航（3.1.1）">
          <outline text="抽奖活动发起人信息">
            <outline text="头像"/>
            <outline text="昵称"/>
          </outline>
          <outline text="消息订阅按钮"/>
          <outline text="汉堡菜单（个人中心）">
            <outline text="用户个人信息"/>
            <outline text="我参与的抽奖记录">
              <outline text="已参与的抽奖">
                <outline text="未开奖"/>
                <outline text="已开奖"/>
              </outline>
              <outline text="中奖记录"/>
            </outline>
            <outline text="常见问题"/>
            <outline text="联系客服"/>
            <outline text="我要投诉"/>
          </outline>
        </outline>
        <outline text="轮播图 Banner 区域（3.1.2）">
          <outline text="用户参与抽奖跑马灯（左上角）"/>
          <outline text="Banner 图"/>
        </outline>
        <outline text="倒计时（3.1.3）"/>
        <outline text="赞助商信息展示（3.1.4）">
          <outline text="赞助商 Logo"/>
          <outline text="赞助商名称"/>
          <outline text="赞助商简述"/>
          <outline text="「去体验」按钮"/>
        </outline>
        <outline text="活动简述（3.1.5）">
          <outline text="文字、图片、视频"/>
          <outline text="「展开更多」按钮"/>
        </outline>
        <outline text="参与抽奖 CTA 按钮区">
          <outline text="参与抽奖 CTA 按钮（3.1.6）">
            <outline text="主按钮"/>
            <outline text="按钮上方的小提示"/>
          </outline>
          <outline text="参与者社交证明（3.1.7）">
            <outline text="头像堆叠"/>
            <outline text="参与人数"/>
            <outline text="查看全部入口"/>
          </outline>
          <outline text="抽奖码展示（3.1.8）"/>
        </outline>
        <outline text="任务列表区（3.1.9）">
          <outline text="关注访问类任务卡片（3.1.10）"/>
          <outline text="邀请裂变类任务卡片（3.1.11）"/>
        </outline>
        <outline text="参与者列表浮层（3.1.12）"/>
        <outline text="登录注册弹窗（全局 3.0.1）"/>
      </outline>
      <outline text="3.2 开奖后页面">
        <outline text="底层页面（活动结束公示页）">
          <outline text="顶部导航（复用 3.1.1）"/>
          <outline text="轮播图 Banner 区域（复用 3.1.2）"/>
          <outline text="倒计时（复用 3.1.3）"/>
          <outline text="赞助商信息展示（复用 3.1.4）"/>
          <outline text="活动简述（复用 3.1.5）"/>
          <outline text="参与抽奖 CTA 按钮区">
            <outline text="参与抽奖 CTA 按钮（复用 3.1.6）"/>
            <outline text="参与者社交证明（复用 3.1.7）"/>
            <outline text="抽奖码展示（复用 3.1.8）"/>
          </outline>
          <outline text="中奖名单公示区（3.2.6）"/>
        </outline>
        <outline text="顶层弹窗（页面加载完成后自动触发）">
          <outline text="开奖结果弹窗（3.2.2）">
            <outline text="中奖喜报视图">
              <outline text="全屏氛围背景（撒花、礼炮动效）"/>
              <outline text="结果标题"/>
              <outline text="中奖奖品大图"/>
              <outline text="领奖交互区域（3.2.3）">
                <outline text="立即领奖按钮"/>
                <outline text="炫耀分享按钮"/>
              </outline>
            </outline>
            <outline text="未中奖遗憾视图">
              <outline text="情感化插画（加油、感谢参与）"/>
              <outline text="结果文案与竞争数据"/>
              <outline text="导流交互区域（3.2.5）">
                <outline text="查看中奖名单按钮"/>
              </outline>
            </outline>
            <outline text="中奖失效遗憾视图（3.2.4）">
              <outline text="警示色标题"/>
              <outline text="盖有 EXPIRED 印章的奖品图"/>
              <outline text="失效说明"/>
              <outline text="导流主按钮"/>
            </outline>
          </outline>
        </outline>
        <outline text="参与者列表浮层（复用 3.1.12）"/>
        <outline text="登录注册弹窗（全局 3.0.1）"/>
      </outline>
    </outline>
  </body>
</opml>
